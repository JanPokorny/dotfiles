{
  "cli_default_open_behavior": "existing_window",
  "title_bar": {
    "show_sign_in": false,
  },
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Gruvbox Dark Hard",
  },
  "icon_theme": {
    "mode": "light",
    "light": "Material Icon Theme",
    "dark": "Material Icon Theme",
  },
  "diff_view_style": "unified",
  "project_panel": {
    "dock": "left",
  },
  "disable_ai": true,
  "edit_predictions": {
    "provider": "zed",
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "terminal": {
    "dock": "bottom",
    "flexible": false,
    "shell": {
      "program": "fish",
    },
    "font_family": "JetBrainsMono Nerd Font",
    "max_scroll_history_lines": 100000,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "git": {
    "inline_blame": {
      "enabled": true,
    },
  },
  "base_keymap": "VSCode",
  "use_system_window_tabs": true,
  "autosave": "on_focus_change",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "file_types": {
    "markdown": ["*.mdx"],
  },
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 13,
  "languages": {
    "Python": {
      "language_servers": ["pyrefly"],
    },
  },
}

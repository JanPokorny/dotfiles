{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "permission": "allow",
  "model": "ete-litellm/aws/claude-opus-5-5",
  "provider": {
    "ete-litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ETE LiteLLM",
      "options": {
        "baseURL": "https://ete-litellm.ai-models.vpc.res.ibm.com/v1",
        "apiKey": "{env:ETE_LITELLM_API_KEY}"
      },
      "models": {
        "azure/gpt-6-astra": {
          "name": "GPT-6 Astra",
          "reasoning": true,
          "attachment": true,
          "tool_call": true,
          "limit": { "context": 1000000, "output": 100000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "cost": {
            "input": 10, "output": 50, "cache_read": 1, "cache_write": 12.5,
            "context_over_200k": { "input": 20, "output": 75, "cache_read": 2, "cache_write": 25 }
          }
        },
        "aws/claude-opus-5-5": {
          "name": "Claude Opus 5.5",
          "reasoning": true,
          "attachment": true,
          "tool_call": true,
          "limit": { "context": 1000000, "output": 32000 },
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "cost": { "input": 4, "output": 20, "cache_read": 0.2, "cache_write": 5 }
        }
      }
    }
  }
}

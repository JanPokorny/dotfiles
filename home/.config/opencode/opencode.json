{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "permission": "allow",
  "model": "local/ete/aws/claude-opus-5-5",
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local gateway",
      "options": {
        "baseURL": "http://127.0.0.1:47900/v1",
        "apiKey": "local"
      },
      "models": {
        "ete/azure/gpt-6-astra": {
          "name": "GPT-6 Astra",
          "reasoning": true,
          "attachment": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 100000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "cost": {
            "input": 10,
            "output": 50,
            "cache_read": 1,
            "cache_write": 12.5,
            "context_over_200k": {
              "input": 20,
              "output": 75,
              "cache_read": 2,
              "cache_write": 25
            }
          }
        },
        "ete/aws/claude-opus-5-5": {
          "name": "Claude Opus 5.5",
          "reasoning": true,
          "attachment": true,
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 32000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "cost": {
            "input": 4,
            "output": 20,
            "cache_read": 0.2,
            "cache_write": 5
          }
        },
        "cb/rits/zai-org/glm-5-3": {
          "name": "GLM-5.3 (CurveBender)",
          "reasoning": true,
          "tool_call": true
        },
        "dam-dev/deepseek-v4.1-flash": {
          "name": "DeepSeek-V4.1-Flash-1017 (dam-dev)",
          "reasoning": true,
          "tool_call": true,
          "limit": {
            "context": 262144,
            "output": 32000
          }
        }
      }
    }
  }
}

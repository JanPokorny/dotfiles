{
  "syncClaudeAiSkills": false,
  "env": {
    "CLAUDE_CODE_HARBOR_KITE": "0"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "anthropic-skills:docs": "off",
    "anthropic-skills:google-workspace": "off",
    "anthropic-skills:docx": "off",
    "anthropic-skills:import-memory": "off",
    "anthropic-skills:morning": "off",
    "anthropic-skills:pdf": "off",
    "anthropic-skills:pptx": "off",
    "anthropic-skills:skill-creator": "off",
    "anthropic-skills:xlsx": "off"
  },
  "disableBundledSkills": true,
  "disableAgentView": true,
  "disableRemoteControl": true,
  "enabledPlugins": {
    "cc-plugin-you-should-know@builtin": true,
    "cc-plugin-agents-md@builtin": true,
    "cc-plugin-telemetry@builtin": false,
    "cc-plugin-sec-default@builtin": false,
    "cc-plugin-plugin-authoring@builtin": false,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "outputStyle": "Concise",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "crossSessionInbound": "refuse",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "model": "opus",
  "hooks": {
    "PermissionRequest": [
      {
        "_otty": true,
        "hooks": [
          {
            "command": "OTTY_CLI='/Applications/Otty.app/Contents/MacOS/otty-cli' '/Applications/Otty.app/Contents/Resources/agent-integration/claude/otty-hook.sh' awaiting \"$PPID\"",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "_otty": true,
        "hooks": [
          {
            "command": "OTTY_CLI='/Applications/Otty.app/Contents/MacOS/otty-cli' '/Applications/Otty.app/Contents/Resources/agent-integration/claude/otty-hook.sh' processing \"$PPID\"",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "_otty": true,
        "hooks": [
          {
            "command": "OTTY_CLI='/Applications/Otty.app/Contents/MacOS/otty-cli' '/Applications/Otty.app/Contents/Resources/agent-integration/claude/otty-hook.sh' processing \"$PPID\"",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "_otty": true,
        "hooks": [
          {
            "command": "OTTY_CLI='/Applications/Otty.app/Contents/MacOS/otty-cli' '/Applications/Otty.app/Contents/Resources/agent-integration/claude/otty-hook.sh' idle \"$PPID\"",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "_otty": true,
        "hooks": [
          {
            "command": "OTTY_CLI='/Applications/Otty.app/Contents/MacOS/otty-cli' '/Applications/Otty.app/Contents/Resources/agent-integration/claude/otty-hook.sh' idle \"$PPID\"",
            "type": "command"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$PASEO_TERMINAL_ID\" ]; then \"${PASEO_HOOK_CLI:-paseo}\" hooks claude Stop; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "_otty": true,
        "hooks": [
          {
            "command": "OTTY_CLI='/Applications/Otty.app/Contents/MacOS/otty-cli' '/Applications/Otty.app/Contents/Resources/agent-integration/claude/otty-hook.sh' error \"$PPID\"",
            "type": "command"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$PASEO_TERMINAL_ID\" ]; then \"${PASEO_HOOK_CLI:-paseo}\" hooks claude StopFailure; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "_otty": true,
        "hooks": [
          {
            "command": "OTTY_CLI='/Applications/Otty.app/Contents/MacOS/otty-cli' '/Applications/Otty.app/Contents/Resources/agent-integration/claude/otty-hook.sh' processing \"$PPID\"",
            "type": "command"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$PASEO_TERMINAL_ID\" ]; then \"${PASEO_HOOK_CLI:-paseo}\" hooks claude UserPromptSubmit; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$PASEO_TERMINAL_ID\" ]; then \"${PASEO_HOOK_CLI:-paseo}\" hooks claude SessionEnd; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"$PASEO_TERMINAL_ID\" ]; then \"${PASEO_HOOK_CLI:-paseo}\" hooks claude Notification; fi",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
